{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "REVALIDATE_SECRET",
        "VITE_ADMIN_API_BASE_URL",
        "VITE_WEB_BASE_URL",
        "VITE_REVALIDATE_TOKEN"
      ]
    },
    "lint": {},
    "test:run": {
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
